@article{huh2027textbridge,
  title       = {<a href="https://openreview.net/forum?id=iul5gUdau1">Can Text Connect Images and Audio Without Paired Training Data? A Controlled Study</a>},
  author      = {Huh, Benjamin and Kim, Hak Hyun and Raj, Yash and Peng, Jason},
  research_area = {interpretability-training},
  research_topic = {multimodal-alignment},
  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> Can separately trained image-text and audio-text connectors support useful image-audio retrieval?</summary><div class="rq-answer"><b>A.</b> The staged connectors produce an above-chance matching signal without image-audio pairs in their own training. On the 4,411-row AudioCaps thumbnail proxy, mean recall reaches 4.13%, versus 0.121% chance. The signal remains weak, varies with the data source and audio encoder, and does not consistently improve when the text model changes. The gallery contains noisy thumbnails and repeated video IDs, and the study has no randomized text-anchor control. It therefore demonstrates a limited retrieval result, not that text itself caused the alignment or that the system is ready for practical search.</div></details>}
}

@article{raj2027personas,
  title       = {<a href="https://openreview.net/forum?id=BRQIInJFXI">The Trait Structure of Language Model Personas</a>},
  author      = {Raj, Yash and Kim, Hak Hyun and Huh, Benjamin and Tian, Yuting and Shapira, Natalie and Vosoughi, Soroush},
  research_area = {interpretability-training},
  research_topic = {interventions},
  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> How much of a language-model persona can a small trait mixture explain, and does that mixture affect behavior?</summary><div class="rq-answer"><b>A.</b> Across 37 personas and three models, mixtures from a 60-trait dictionary use a median of six traits and capture roughly half the persona direction’s length. Adding and removing these mixtures changes recognition more than matched random edits; related mixtures also affect sycophancy and refusal. Broad persona resemblance is easier to recover than distinctions between similar characters. Because the trait dictionary is correlated and linearly dependent, these recipes are not uniquely identified psychological primitives, and the joint interventions do not isolate each trait’s causal contribution.</div></details>}
}

@article{kim2027whichtask,
  title       = {<a href="https://openreview.net/forum?id=PmN7pxrYc3">Which Task Loses? Understanding Asymmetrical Degradation in Model Merging</a>},
  author      = {Kim, Hak Hyun and Chin, Peter},
  research_area = {systems},
  research_topic = {model-merging},
  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> Which task suffers most when fine-tuned models are merged, and can that damage be reduced?</summary><div class="rq-answer"><b>A.</b> Under explicit curvature and stationarity assumptions, two-sided loss bounds predict when the smaller task vector’s task suffers more. GLUE experiments support this ordering under unequal training exposure, while matching exposure compresses norm differences and removes reliable norm-based ordering. On four tested pairs in two model families, shrinking only the larger vector protects the smaller task better than uniform scaling; equalizing at fixed total norm can instead stretch the smaller vector and harm both tasks. Shrinkage can cost the larger task, and the bounds are conditional rather than certified capacity limits for real networks.</div></details>}
}

@article{huh2027morphsae,
  title       = {<a href="https://openreview.net/forum?id=q0QR1ze7vR">MorphSAE: Reserved Sparse Slots without Automatic Component Recovery</a>},
  author      = {Huh, Benjamin and Kim, Hak Hyun and Vosoughi, Soroush},
  research_area = {interpretability-training},
  research_topic = {sparse-autoencoders},
  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> Does reserving sparse slots for separate dictionaries automatically recover meaningful components?</summary><div class="rq-answer"><b>A.</b> No. MorphSAE gives each named dictionary a TopK quota, guaranteeing returned indices rather than positive activations or semantic ownership. The optional cross-dictionary loss reduces its sampled overlap statistic, but quota-only comparisons show no reliable reconstruction advantage, and none of the 12 unsupervised evaluations passes the full functional criterion. A supervised synthetic copy task does yield useful named components, yet a named model with one shared budget performs similarly. The positive result supports that supervised decomposition recipe; it does not attribute the benefit to reserved slots or establish automatic component recovery.</div></details>}
}

@article{kim2027repairs,
  title       = {<a href="https://openreview.net/forum?id=IDUumDpisu">One Failure, Many Repairs: Module-Level Repair Spaces in Vision–Language Models</a>},
  author      = {Kim, Hak Hyun and Chin, Peter and Vosoughi, Soroush},
  research_area = {interpretability-training},
  research_topic = {vision-language},
  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> Does one wrong answer identify one defective module or one place to repair a vision-language model?</summary><div class="rq-answer"><b>A.</b> Not in the tested LLaVA-OneVision-0.5B setting. Training all seven non-empty subsets of the vision encoder, projector, and language model on 13 geometry tasks gives multiple single-module repairs for about 44–45% of Base errors across two seeds. Joint training mostly reallocates existing repairs. On the G02 case studied in depth, vision-only and language-only adaptation use different causal routes that meet at one late decision state. Where parameters change, where the repair is computed, and which module carries it can therefore differ. Repair availability remains specific to the model, training recipe, and answer-scoring protocol.</div></details>}
}

@article{huh2027nfsae,
  title       = {<a href="https://openreview.net/forum?id=sbvkcVAWS9">NF-SAE: Testing an NMF-Inspired Sparse Autoencoder Across Language Models</a>},
  author      = {Huh, Benjamin and Peng, Jason and Kim, Hak Hyun and Vosoughi, Soroush},
  research_area = {interpretability-training},
  research_topic = {sparse-autoencoders},
  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> Does an NMF-inspired sparse autoencoder provide a reliable advantage across language models?</summary><div class="rq-answer"><b>A.</b> NF-SAE constrains its main feature strengths to be nonnegative while retaining signed feature directions and a smaller signed correction branch. In one layer each of Gemma, Pythia, and Qwen, its favorable Gemma results do not transfer consistently; BatchTopK has lower mean reconstruction and output errors on Gemma and Pythia wherever compared. Parameters, compute, relative width, and training choices are not fully matched, and many features remain inactive on evaluation packets. The evidence evaluates a complete recipe, without isolating nonnegativity as the cause or establishing better interpretability.</div></details>}
}

@article{moody2027safestgraph,
  title       = {<a href="https://openreview.net/forum?id=Pc8P3kCecq">Which Graph Is Safest? Predicting Adversarial Capture of LLM Agent Groups from Local Kernels</a>},
  author      = {Moody, Merijn and Kim, Hak Hyun and Elshatlawy, Hatem and Karwacki, Lukasz},
  research_area = {multi-agent},
  research_topic = {adversarial-robustness},
  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> Can local interactions predict adversarial capture, and is one communication graph always safest?</summary><div class="rq-answer"><b>A.</b> A question-specific switching model calibrated on eight graph–adversary configurations predicts capture on 52 other configurations with mean error 0.012 in the tested six-agent setup. Graph rankings transfer better than absolute capture probabilities, which need recalibration under new questions or attacks. When the adversary chooses its worst-case position, concentrating links on one agent is especially risky; with random placement, rankings can reverse. The most accurate topology also depends on the initial answer distribution and agents’ majority-following behavior. The study thus supports conditional topology selection, not a universally safest graph.</div></details>}
}
