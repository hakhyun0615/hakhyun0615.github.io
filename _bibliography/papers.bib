@article{kim2027worldmodel,
  title       = {<a href="https://openreview.net/forum?id=2nCo30upJb">How a World Model Forms: Separating World Knowledge from Behavioral Competence in Sokoban Transformers</a>},
  author      = {Kim, Hak Hyun and Raj, Yash and Vosoughi, Soroush and Chin, Peter},
  research_area = {interpretability-training},
  research_topic = {world-models},
  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> Does more accurate internal world knowledge make a policy better at acting?</summary><div class="rq-answer"><b>A.</b> In a controlled 7-by-7 Sokoban setting, eight supervision conditions share a 50.5M-parameter Transformer and action-training corpus. Across three seeds, supervising state, action effects, and goal occupancy raises complete-state recovery from 20.8% to 95.5%, while held-out 32–60-step puzzle solving changes from 74.5% to 73.5%. Supervision helps continuation after supplied detours, but doubling training shrinks that advantage on matched handovers. This separates recoverable state information from its behavioral utility; it does not show that world knowledge is unnecessary or establish the mechanism behind the supervision benefit.</div></details>}
}

