@inproceedings{kim2026position,
  selected     = {true},
  title        = {<a href="https://openreview.net/forum?id=fxSfYP7IMI">Position: Multi-Agent Explainability Needs Contracts Before Methods</a>},
  author       = {Kim, Hak Hyun and Huh, Benjamin and Vosoughi, Soroush},
  research_area = {multi-agent},
  research_topic = {multi-agent-explainability},
  booktitle    = {ICML},
  year         = {2026},
  note         = {<details class="rq"><summary><b>Q.</b> Two papers each claim that their method explains multi-agent failures better. What has to be specified before those claims can be compared?</summary><div class="rq-answer"><b>A.</b> Two contracts, declared before any method is proposed. The Research Contract fixes what is being explained, to whom, at what intervention unit, within what evaluation bounds, under what adversarial conditions, and with what audit trail. The Agent Contract states the behavior the system was supposed to produce, as obligations, permissions, prohibitions, violation criteria, and accountability chains, which is the baseline a deviation gets explained against. Without both, a reported score is not comparable across papers and cannot be carried into a deployment decision.</div></details>}
}

@article{kim2026tsaga,
  selected    = {true},
  title       = {<a href="https://papers.ssrn.com/sol3/papers.cfm?abstract_id=4971984">TSA-GA Net: A Dual Attention Mechanism for Predicting Real Estate Transaction Prices</a>},
  author      = {Kim*, Hak Hyun and Yoo*, Hwankyu and Oh, Hayoung},
  research_area = {applied},
  journal     = {Heliyon},
  year        = {2026},
  note        = {<details class="rq"><summary><b>Q.</b> Can sparse, irregular real estate transaction records be predicted directly, rather than through the price index prior work fell back on?</summary><div class="rq-answer"><b>A.</b> Yes, on the Seoul apartment transactions studied here. We aggregate records by apartment complex and combine complex attributes with macroeconomic indicators to handle sparse, irregular observations. Time-series attention follows each complex over a twelve-month window, while geographic attention links neighboring complexes in the same month. The model outperforms the statistical, machine-learning, and time-series deep-learning baselines compared on this dataset. This supports direct transaction-price prediction in the tested setting; it does not establish performance in other cities or market conditions.</div></details>}
}

@article{kim2023apartment,
  title       = {<a href="https://koreascience.kr/article/JAKO202313759686729.page">Apartment Price Prediction Using Deep Learning and Machine Learning</a>},
  author      = {Kim, Hak Hyun and Yoo, Hwankyu and Oh, Hayoung},
  research_area = {applied},
  journal     = {KIPS Transactions on Software and Data Engineering},
  year        = {2023},
  note        = {<details class="rq"><summary><b>Q.</b> What does apartment price prediction gain from scaling the dataset and searching for variables systematically?</summary><div class="rq-answer"><b>A.</b> We assemble 878,928 Seoul transactions from 2015 to 2020 with 42 variables, where earlier studies used a few thousand records and chose their variables by hand. After addressing multicollinearity, we compare five variable-selection methods across four models. Tested on 2021, the model recovers the spatial pattern of expensive apartment complexes but systematically underestimates prices. The larger dataset enables a systematic comparison, but price-level error remains a practical limitation.</div></details>}
}

@inproceedings{kim2026emergence,
  title       = {<a href="https://neurips.cc/virtual/2026/poster/151787">Inside Emergence: Structure-Behaviour Gaps in Language Model Training</a>},
  author      = {Kim, Hak Hyun and Raj, Yash and Vosoughi, Soroush},
  research_area = {training-dynamics},
  research_topic = {training-dynamics},
  booktitle   = {NeurIPS},
  year        = {2026},
  note        = {<details class="rq"><summary><b>Q.</b> When a capability appears abruptly during training, does the structure behind it change at that moment, or was it already in place?</summary><div class="rq-answer"><b>A.</b> Usually earlier. Across 150 Pythia training trajectories spanning three model scales and five tasks, spectral measurements show that structural reorganization precedes measurable capability in 94% of runs, often by thousands of steps. Ablations at pre-emergence checkpoints show that already-prominent components carry much of the capability that appears later. Whether behavioral emergence looks sharper than structural change depends on the task: subject-verb agreement and induction show sharper behavioral transitions, while factual recall and docstrings show the two changing together. The timing gap is widespread in these experiments, but the shape of emergence is task-dependent.</div></details>}
}

@inproceedings{kim2026curvature,
  selected    = {true},
  title       = {<a href="https://neurips.cc/virtual/2026/poster/153574">A Curvature Phase Transition Governs Coherence Penalty Efficiency Against Feature Absorption in SAEs</a>},
  author      = {Kim, Hak Hyun and Raj, Yash and Chin, Peter and Vosoughi, Soroush},
  research_area = {interpretability},
  research_topic = {sparse-autoencoders},
  booktitle   = {NeurIPS},
  year        = {2026},
  note        = {<details class="rq"><summary><b>Q.</b> When does a coherence penalty reduce feature absorption in sparse autoencoders?</summary><div class="rq-answer"><b>A.</b> Feature absorption occurs when one sparse autoencoder atom carries several concepts. For penalties based on pairwise feature overlaps raised to <i>p</i>, curvature at an absorbed solution changes sign at <i>p</i> = 2 in the orthogonal idealization. Below 2, sufficient penalty removes the local minimum; above 2, no such threshold exists. Correlated features make <i>p</i> = 2 weakly destabilizing, offering a practical balance against reconstruction cost. On Pythia-160M and Gemma-2-2B, full absorption events fall 89%, which is not explained by reduced feature firing. The effect can reverse in independent-threshold architectures. This identifies when the penalty works, rather than a universal solution to absorption.</div></details>}
}

@inproceedings{huh2026positional,
  title       = {<a href="https://neurips.cc/virtual/2026/poster/153926">The Missing Positional Story in LLMs: A Case Study of Shift-Invariant Attention</a>},
  author      = {Huh, Benjamin and Kim, Hak Hyun and Tian, Yuting and Peng, Jason and Kang, Christopher and Vosoughi, Soroush},
  research_area = {interpretability},
  research_topic = {interventions},
  booktitle   = {NeurIPS},
  year        = {2026},
  note        = {<details class="rq"><summary><b>Q.</b> Do language models actively learn to use shift-invariant attention, or does it simply follow from their positional embeddings?</summary><div class="rq-answer"><b>A.</b> Models actively learn to use it. Targeted ablations degrade performance in proportion to each head's shift-invariant signal, and similar structure appears in models trained with absolute positional embeddings. Its strongest observed role is in offset-structured retrieval and positional routing; how to train it for richer semantic invariances remains an open question.</div></details>}
}

@article{kim2026knowing,
  title       = {<a href="https://openreview.net/forum?id=ScI9VVegt4">Probing and Steering Constraint Following in Multi-Turn Dialogue</a>},
  author      = {Kim, Hak Hyun and Huh, Benjamin and Vosoughi, Soroush},
  research_area = {interpretability},
  research_topic = {interventions},
  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> Can a failed dialogue constraint remain decodable, and do individually useful steering methods work better together?</summary><div class="rq-answer"><b>A.</b> Across four models and 230 twenty-turn sessions, probes recover constraint identity before many checker-failed answers. That establishes decodable information while the instruction remains in context, not functional use. At unit strength, combined activation-direction and attention steering improves checker pass rates by 21.7–29.8 percentage points over baseline and beats either alone, but its gains are subadditive. Across the full grid of steering strengths, adding activation-direction steering to attention loses more successes than it gains in 24 of 36 comparisons. These are exploratory policy comparisons with imperfect checks and independently generated histories; they do not identify the natural cause of compliance decay.</div></details>}
}

