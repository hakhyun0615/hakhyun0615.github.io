@article{huh2027textbridge,
  title       = {<a href="https://openreview.net/forum?id=iul5gUdau1">Can Text Connect Images and Audio Without Paired Training Data? A Controlled Study</a>},
  author      = {Huh, Benjamin and Kim, Hak Hyun and Raj, Yash and Peng, Jason},
  research_area = {training-dynamics},
  research_topic = {multimodal-alignment},
  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> Can separately trained image-text and audio-text connectors support useful image-audio retrieval?</summary><div class="rq-answer"><b>A.</b> The staged connectors produce an above-chance matching signal without image-audio pairs in their own training. On the 4,411-row AudioCaps thumbnail proxy, mean recall reaches 4.13%, versus 0.121% chance. The signal remains weak, varies with the data source and audio encoder, and does not consistently improve when the text model changes. The gallery contains noisy thumbnails and repeated video IDs, and the study has no randomized text-anchor control. It therefore demonstrates a limited retrieval result, not that text itself caused the alignment or that the system is ready for practical search.</div></details>}
}

@article{raj2027personas,
  title       = {<a href="https://openreview.net/forum?id=BRQIInJFXI">The Trait Structure of Language Model Personas</a>},
  author      = {Raj, Yash and Kim, Hak Hyun and Huh, Benjamin and Tian, Yuting and Shapira, Natalie and Vosoughi, Soroush},
  research_area = {interpretability},
  research_topic = {interventions},
  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> How much of a language-model persona can a small trait mixture explain, and does that mixture affect behavior?</summary><div class="rq-answer"><b>A.</b> Across 37 personas and three models, mixtures from a 60-trait dictionary use a median of six traits and capture roughly half the persona direction’s length. Adding and removing these mixtures changes recognition more than matched random edits; related mixtures also affect sycophancy and refusal. Broad persona resemblance is easier to recover than distinctions between similar characters. Because the trait dictionary is correlated and linearly dependent, these recipes are not uniquely identified psychological primitives, and the joint interventions do not isolate each trait’s causal contribution.</div></details>}
}

@article{kim2027whichtask,
  title       = {<a href="https://openreview.net/forum?id=PmN7pxrYc3">Which Task Loses? Understanding Asymmetrical Degradation in Model Merging</a>},
  author      = {Kim, Hak Hyun and Chin, Peter},
  research_area = {systems},
  research_topic = {model-merging},
  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> Which task suffers most when fine-tuned models are merged, and can that damage be reduced?</summary><div class="rq-answer"><b>A.</b> Under explicit curvature and stationarity assumptions, two-sided loss bounds predict when the smaller task vector’s task suffers more. GLUE experiments support this ordering under unequal training exposure, while matching exposure compresses norm differences and removes reliable norm-based ordering. On four tested pairs in two model families, shrinking only the larger vector protects the smaller task better than uniform scaling; equalizing at fixed total norm can instead stretch the smaller vector and harm both tasks. Shrinkage can cost the larger task, and the bounds are conditional rather than certified capacity limits for real networks.</div></details>}
}

@article{huh2027morphsae,
  title       = {<a href="https://openreview.net/forum?id=q0QR1ze7vR">MorphSAE: Reserved Sparse Slots without Automatic Component Recovery</a>},
  author      = {Huh, Benjamin and Kim, Hak Hyun and Vosoughi, Soroush},
  research_area = {interpretability},
  research_topic = {sparse-autoencoders},
  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> Does reserving sparse slots for separate dictionaries automatically recover meaningful components?</summary><div class="rq-answer"><b>A.</b> No. MorphSAE gives each named dictionary a TopK quota, guaranteeing returned indices rather than positive activations or semantic ownership. The optional cross-dictionary loss reduces its sampled overlap statistic, but quota-only comparisons show no reliable reconstruction advantage, and none of the 12 unsupervised evaluations passes the study’s full set of component-recovery checks. A supervised synthetic copy task does yield useful named components, yet a named model with one shared budget performs similarly. The positive result supports that supervised decomposition recipe; it does not attribute the benefit to reserved slots or establish automatic component recovery.</div></details>}
}

@article{kim2027repairs,
  title       = {<a href="https://openreview.net/forum?id=IDUumDpisu">One Failure, Many Repairs: Module-Level Repair Spaces in Vision–Language Models</a>},
  author      = {Kim, Hak Hyun and Chin, Peter and Vosoughi, Soroush},
  research_area = {interpretability},
  research_topic = {vision-language},
  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> Does one wrong answer identify one defective module or one place to repair a vision-language model?</summary><div class="rq-answer"><b>A.</b> Not in the tested LLaVA-OneVision-0.5B setting. Training all seven non-empty subsets of the vision encoder, projector, and language model on 13 geometry tasks gives multiple single-module repairs for about 44–45% of base-model errors across two seeds. Joint training mostly reallocates existing repairs. In one case studied in depth, vision-only and language-only adaptation use different causal routes that meet at one late decision state. Where parameters change, where the repair is computed, and which module carries it can therefore differ. Repair availability remains specific to the model, training recipe, and answer-scoring protocol.</div></details>}
}

@article{huh2027nfsae,
  title       = {<a href="https://openreview.net/forum?id=sbvkcVAWS9">NF-SAE: Testing an NMF-Inspired Sparse Autoencoder Across Language Models</a>},
  author      = {Huh, Benjamin and Peng, Jason and Kim, Hak Hyun and Vosoughi, Soroush},
  research_area = {interpretability},
  research_topic = {sparse-autoencoders},
  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> Does an NMF-inspired sparse autoencoder provide a reliable advantage across language models?</summary><div class="rq-answer"><b>A.</b> NF-SAE constrains its main feature strengths to be nonnegative while retaining signed feature directions and a smaller signed correction branch. In one layer each of Gemma, Pythia, and Qwen, its favorable Gemma results do not transfer consistently; BatchTopK has lower mean reconstruction and output errors on Gemma and Pythia wherever compared. Parameters, compute, relative width, and training choices are not fully matched, and many features remain inactive on evaluation packets. The evidence evaluates a complete recipe, without isolating nonnegativity as the cause or establishing better interpretability.</div></details>}
}

@article{moody2027safestgraph,
  title       = {<a href="https://openreview.net/forum?id=Pc8P3kCecq">Which Graph Is Safest? Predicting Adversarial Capture of LLM Agent Groups from Local Kernels</a>},
  author      = {Moody, Merijn and Kim, Hak Hyun and Elshatlawy, Hatem and Karwacki, Lukasz},
  research_area = {multi-agent},
  research_topic = {adversarial-robustness},
  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> Can local interactions predict adversarial capture, and is one communication graph always safest?</summary><div class="rq-answer"><b>A.</b> A question-specific switching model calibrated on eight graph–adversary configurations predicts capture on 52 other configurations with mean error 0.012 in the tested six-agent setup. Graph rankings transfer better than absolute capture probabilities, which need recalibration under new questions or attacks. When the adversary chooses its worst-case position, concentrating links on one agent is especially risky; with random placement, rankings can reverse. The most accurate topology also depends on the initial answer distribution and agents’ majority-following behavior. The study thus supports conditional topology selection, not a universally safest graph.</div></details>}
}

@inproceedings{kim2026translation,
  title       = {<a href="https://aclanthology.org/2026.stereacult-1.11/">Translation Is Not Representation: English-Hub Routing in Cross-Lingual Bias Benchmarks</a>},
  author      = {Kim, Hak Hyun and Huh, Benjamin},
  research_area = {interpretability},
  research_topic = {multilingual},
  booktitle   = {ACL 2026 Workshop on StereACuLT},
  note        = {<details class="rq"><summary><b>Q.</b> Are the representations underlying cross-lingual bias benchmark scores language-agnostic?</summary><div class="rq-answer"><b>A.</b> Not necessarily. Across architecture-matched 13B models, English bias questions and their Japanese and Korean translations can have similar representation geometry while internal language preferences vary with training history. English-hub signals weaken after language-specific adaptation and under balanced bilingual training. Crucially, activation patching of English-hub states does not transplant the corresponding bias behavior. The benchmark scores therefore capture language-specific stereotype preferences, rather than simply reflecting English routing. High geometric alignment alone does not establish language-agnostic representations of bias or make the underlying constructs directly comparable across languages.</div></details>}
}

@inproceedings{huh2026easy,
  title       = {Easy to Add, Hard to Erase: Causal Evidence on Stereotype Editing in LLMs},
  author      = {Huh, Benjamin and Kim, Hak Hyun and Peng, Jason},
  research_area = {interpretability},
  research_topic = {interventions},
  booktitle   = {ACL 2026 Workshop on StereACuLT},
  note        = {<details class="rq"><summary><b>Q.</b> If a stereotype is carried by a linear direction in the residual stream, does erasing that direction stop the behavior?</summary><div class="rq-answer"><b>A.</b> No. We construct a residual-stream direction from paired stereotype and anti-stereotype items, then compare adding it with projecting it out at the decision token. Adding the direction increases stereotypical choices; removal mainly changes confidence, with few decisions flipping because most items lie far from the decision boundary. Component rankings offer limited guidance: predicted signs are unreliable, and one in seven to one in four top-ranked components push against the intended edit. A direction that can amplify a stereotype does not necessarily provide an effective way to erase it.</div></details>}
}

@inproceedings{kim2026clasp,
  title       = {<a href="https://openreview.net/forum?id=D7Z4YZS0zG">CLASP: Retrofitting Cost--Latency SLO Compliance onto Any LLM Router</a>},
  author      = {Kim, Hak Hyun and Huh, Benjamin and Moon, Jimin and Lee, Chia-Wei and Peng, Jason and Marrero, Wesley J. and Vosoughi, Soroush},
  research_area = {systems},
  research_topic = {runtime-control},
  booktitle   = {ICML 2026 Workshop on DEMO},
  note        = {<details class="rq"><summary><b>Q.</b> How can an LLM router be kept inside a cost and latency budget, without retraining it?</summary><div class="rq-answer"><b>A.</b> CLASP adds a budget controller to an existing router. Offline, it uses cached cost and latency measurements to exclude actions that exceed the allowed violation rate and calibrates two penalty weights. Online, it subtracts weighted cost and latency predictions from the router's quality score before selecting a topology and model tier. Changing a budget requires updating the mask and weights rather than retraining the router. The weights also adapt to observed deployment outcomes, so compliance depends on calibration and monitoring as conditions change.</div></details>}
}

@inproceedings{haider2026policyllm,
  title       = {<a href="https://openreview.net/forum?id=9raGR7DnlY">PolicyLLM: Neuro-Symbolic Policy Extraction and Enforcement for Runtime AI Governance</a>},
  author      = {Haider*, Syed Ali and Huh*, Benjamin and Kim*, Hak Hyun and Nalagatla*, Goutham and Guerrero Alvarez, Carlos and Raj, Yash and Vosoughi, Soroush},
  research_area = {systems},
  research_topic = {runtime-control},
  booktitle   = {ICML 2026 Workshop on TAIGR},
  note        = {<details class="rq"><summary><b>Q.</b> How can a deployment produce a per-output record of which policies applied, what facts were checked, and what was decided?</summary><div class="rq-answer"><b>A.</b> We present PolicyLLM, which offline compiles policy documents into a decision graph and uses the Z3 SMT solver to find contradictions among the compiled rules, settling them by an explicit priority ordering. At inference time it both steers generation with policy-derived scaffolding and checks the response against that bundle, routing it to pass, auto-correct, regenerate, or escalate, and appending the decision to a hash-chained log. The solver certifies the rules it was handed, not that those rules were read correctly out of the policy documents, so a response it cannot verify goes to a human reviewer rather than to the user.</div></details>}
}
