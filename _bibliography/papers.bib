@inproceedings{kim2026position,
  selected     = {true},
  title        = {<a href="https://openreview.net/forum?id=fxSfYP7IMI">Position: Multi-Agent Explainability Needs Contracts Before Methods</a>},
  author       = {Kim, Hak Hyun and Huh, Benjamin and Vosoughi, Soroush},
  research_area = {multi-agent},
  research_topic = {multi-agent-explainability},
  booktitle    = {International Conference on Machine Learning (ICML), Position Paper Track},
  year         = {2026},
  note         = {<details class="rq"><summary><b>Q.</b> Two papers each claim that their method explains multi-agent failures better. What has to be specified before those claims can be compared?</summary><div class="rq-answer"><b>A.</b> Two contracts, declared before any method is proposed. The Research Contract fixes what is being explained, to whom, at what intervention unit, within what evaluation bounds, under what adversarial conditions, and with what audit trail. The Agent Contract states the behavior the system was supposed to produce, as obligations, permissions, prohibitions, violation criteria, and accountability chains, which is the baseline a deviation gets explained against. Without both, a reported score is not comparable across papers and cannot be carried into a deployment decision.</div></details>}
}

@inproceedings{kim2026translation,
  title       = {<a href="https://aclanthology.org/2026.stereacult-1.11/">Translation Is Not Representation: English-Hub Routing in Cross-Lingual Bias Benchmarks</a>},
  author      = {Kim, Hak Hyun and Huh, Benjamin},
  research_area = {interpretability-training},
  research_topic = {multilingual},
  booktitle   = {ACL 2026 Workshop on StereACuLT},
  note        = {<details class="rq"><summary><b>Q.</b> Are the representations underlying cross-lingual bias benchmark scores language-agnostic?</summary><div class="rq-answer"><b>A.</b> Not necessarily. We compare English bias questions with their Japanese translations across English-centric, Japanese-adapted, and balanced bilingual models. CKA finds strong geometric alignment between the languages in every model. But a multi-anchor logit lens shows that internal language preferences vary with training history despite this similarity, with English-hub signals weakening after Japanese adaptation and under balanced bilingual training. Even with high CKA, cross-lingual bias scores describe language-specific stereotype preferences without establishing language-agnostic representations of bias.</div></details>}
}

@inproceedings{huh2026easy,
  title       = {Easy to Add, Hard to Erase: Causal Evidence on Stereotype Editing in LLMs},
  author      = {Huh, Benjamin and Kim, Hak Hyun and Peng, Jason},
  research_area = {interpretability-training},
  research_topic = {interventions},
  booktitle   = {ACL 2026 Workshop on StereACuLT},
  note        = {<details class="rq"><summary><b>Q.</b> If a stereotype is carried by a linear direction in the residual stream, does erasing that direction stop the behavior?</summary><div class="rq-answer"><b>A.</b> No. We build the direction from the gap between a stereotype item and its anti-stereotype twin, measured at the word where the two actually differ, then at the decision token either add that direction back or project it out, and compare the two edits on the same items. Adding it moves the model toward the stereotype; projecting it out shifts confidence without flipping many decisions, because most items sit far from the boundary. Component rankings do not rescue this: their predicted signs are not reliable enough to edit by, and between one in seven and one in four of the top-ranked components push against the intended edit. Finding the direction earns a control knob, not a fix.</div></details>}
}

@inproceedings{kim2026clasp,
  title       = {<a href="https://openreview.net/forum?id=D7Z4YZS0zG">CLASP: Retrofitting Cost--Latency SLO Compliance onto Any LLM Router</a>},
  author      = {Kim, Hak Hyun and Huh, Benjamin and Moon, Jimin and Lee, Chia-Wei and Peng, Jason and Marrero, Wesley J. and Vosoughi, Soroush},
  research_area = {systems},
  research_topic = {runtime-control},
  booktitle   = {ICML 2026 Workshop on DEMO},
  note        = {<details class="rq"><summary><b>Q.</b> How can an LLM router be kept inside a cost and latency budget, without retraining it?</summary><div class="rq-answer"><b>A.</b> We introduce CLASP, a controller that sits on top of any existing router so that its choices of topology and model tier violate a per-query cost and latency budget no more often than the target allows. Offline, it reads a cost and latency cache and masks out the actions that breach the budget too often, then calibrates one penalty weight for cost and one for latency. Online, it predicts each query's cost and latency and subtracts those two weighted penalties from the router's own quality score before choosing an action. A new budget therefore costs a recomputed mask and two weights rather than a retrained router, and when the deployment drifts the weights keep updating from what actually happened.</div></details>}
}

@inproceedings{haider2026policyllm,
  title       = {<a href="https://openreview.net/forum?id=9raGR7DnlY">PolicyLLM: Neuro-Symbolic Policy Extraction and Enforcement for Runtime AI Governance</a>},
  author      = {Haider*, Syed Ali and Huh*, Benjamin and Kim*, Hak Hyun and Nalagatla*, Goutham and Guerrero Alvarez, Carlos and Raj, Yash and Vosoughi, Soroush},
  research_area = {systems},
  research_topic = {runtime-control},
  booktitle   = {ICML 2026 Workshop on TAIGR},
  note        = {<details class="rq"><summary><b>Q.</b> How can a deployment produce a per-output record of which policies applied, what facts were checked, and what was decided?</summary><div class="rq-answer"><b>A.</b> We present PolicyLLM, which offline compiles policy documents into a decision graph and uses the Z3 SMT solver to find contradictions among the compiled rules, settling them by an explicit priority ordering. At inference time it both steers generation with policy-derived scaffolding and checks the response against that bundle, routing it to pass, auto-correct, regenerate, or escalate, and appending the decision to a hash-chained log. The solver certifies the rules it was handed, not that those rules were read correctly out of the policy documents, so a response it cannot verify goes to a human reviewer rather than to the user.</div></details>}
}

@article{kim2026tsaga,
  selected    = {true},
  title       = {<a href="https://papers.ssrn.com/sol3/papers.cfm?abstract_id=4971984">TSA-GA Net: A Dual Attention Mechanism for Predicting Real Estate Transaction Prices</a>},
  author      = {Kim*, Hak Hyun and Yoo*, Hwankyu and Oh, Hayoung},
  research_area = {applied},
  journal     = {Heliyon},
  year        = {2026},
  note        = {<details class="rq"><summary><b>Q.</b> Can sparse, irregular real estate transaction records be predicted directly, rather than through the price index prior work fell back on?</summary><div class="rq-answer"><b>A.</b> Yes. We run the experiments on apartment transaction records from Seoul. We aggregate the apartments by complex, then embed the complex attributes together with macroeconomic indicators, which turns the sparse, irregular records into input a time series model can take. Two attention stages follow: time series attention over a twelve-month window of the same complex, which captures its price trend, and geographic attention across complexes in the same sub-district at the same month, since neighboring prices move together. This beats statistical, machine learning, and other time series deep learning baselines.</div></details>}
}

@article{kim2023apartment,
  title       = {<a href="https://koreascience.kr/article/JAKO202313759686729.page">Apartment Price Prediction Using Deep Learning and Machine Learning</a>},
  author      = {Kim, Hak Hyun and Yoo, Hwankyu and Oh, Hayoung},
  research_area = {applied},
  journal     = {KIPS Transactions on Software and Data Engineering},
  year        = {2023},
  note        = {<details class="rq"><summary><b>Q.</b> What does apartment price prediction gain from scaling the dataset and searching for variables systematically?</summary><div class="rq-answer"><b>A.</b> We assemble 878,928 Seoul transactions from 2015 to 2020 with 42 variables, where earlier studies used a few thousand records and chose their variables by hand. After clearing multicollinearity we compare five variable selection methods against four models. Tested on 2021, the predicted map of expensive complexes matches the real one almost exactly, but the predicted prices come out too low across the board.</div></details>}
}

@inproceedings{kim2026emergence,
  title       = {Inside Emergence: Structure-Behaviour Gaps in Language Model Training},
  author      = {Kim, Hak Hyun and Raj, Yash and Vosoughi, Soroush},
  research_area = {interpretability-training},
  research_topic = {training-dynamics},
  booktitle   = {NeurIPS},
  year        = {2026},
  note        = {<details class="rq"><summary><b>Q.</b> When a capability appears abruptly during training, does the structure behind it change at that moment, or was it already in place?</summary><div class="rq-answer"><b>A.</b> Usually earlier. Tracking the spectra of mean-ablation patching matrices across 150 Pythia trajectories from 70M to 410M, 3 scales &times; 5 tasks &times; 10 seeds, structural reorganization completes before the capability becomes measurable in 94% of runs, by thousands of steps. Ablating at one of those pre-emergence checkpoints confirms it: the components already prominent there carry most of the capability that surfaces later. On sharpness the field has argued over whether the jump happens inside the model or is manufactured by the metric used to score it. It turns out to depend on the task. For subject-verb agreement and induction the behavior curve turns much more sharply than the structural one, while for factual recall and docstrings the two turn together. Both patterns are present, in different tasks.</div></details>}
}

@inproceedings{kim2026curvature,
  selected    = {true},
  title       = {A Curvature Phase Transition Governs Coherence Penalty Efficiency Against Feature Absorption in SAEs},
  author      = {Kim, Hak Hyun and Raj, Yash and Chin, Peter and Vosoughi, Soroush},
  research_area = {interpretability-training},
  research_topic = {sparse-autoencoders},
  booktitle   = {NeurIPS},
  year        = {2026},
  note        = {<details class="rq"><summary><b>Q.</b> Can feature absorption, where one sparse autoencoder atom carries several concepts at once, be solved?</summary><div class="rq-answer"><b>A.</b> Largely. Absorption is a spurious local minimum of the training loss. A coherence penalty summing pairwise overlaps raised to <i>p</i> pushes absorbed atoms apart for any <i>p</i> &gt; 0, but the penalty weight this takes is set by the curvature at that minimum, which we derive in closed form and which changes sign at <i>p</i> = 2. Below 2 that curvature is negative, so once the penalty weight passes a threshold the closed form gives, absorption stops being a minimizer and descent leaves it. Above 2 the curvature is positive and no such threshold exists. At exactly 2 the penalty is curvature-blind, though only in the orthogonal idealization. Measured features are correlated, which makes <i>p</i> = 2 slightly destabilizing rather than neutral and, since lower <i>p</i> costs reconstruction, makes it the practical operating point. The predicted ordering holds on Pythia-160M and Gemma-2-2B, where full absorption events drop 89%, not explained by atoms firing less. The effect can reverse for independent-threshold architectures.</div></details>}
}

@inproceedings{huh2026positional,
  title       = {The Missing Positional Story in LLMs: A Case Study of Shift-Invariant Attention},
  author      = {Huh, Benjamin and Kim, Hak Hyun and Tian, Yuting and Peng, Jason and Kang, Christopher and Vosoughi, Soroush},
  research_area = {interpretability-training},
  research_topic = {interventions},
  booktitle   = {NeurIPS},
  year        = {2026},
  note        = {<details class="rq"><summary><b>Q.</b> Do language models actively learn to use shift-invariant attention, or does it simply follow from their positional embeddings?</summary><div class="rq-answer"><b>A.</b> Models actively learn to use it. Targeted ablations degrade performance in proportion to each head's shift-invariant signal, and similar structure appears in models trained with absolute positional embeddings. Its strongest observed role is in offset-structured retrieval and positional routing; how to train it for richer semantic invariances remains an open question.</div></details>}
}

@article{kim2026knowing,
  title       = {<a href="https://openreview.net/forum?id=ScI9VVegt4">Probing and Steering Constraint Following in Multi-Turn Dialogue</a>},
  author      = {Kim, Hak Hyun and Huh, Benjamin and Vosoughi, Soroush},
  research_area = {interpretability-training},
  research_topic = {interventions},
  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> Can a failed dialogue constraint remain decodable, and do individually useful steering methods work better together?</summary><div class="rq-answer"><b>A.</b> Across four models and 230 twenty-turn sessions, probes recover constraint identity before many checker-failed answers. That establishes decodable information while the instruction remains in context, not functional use. At unit strength, combined CAV and attention steering improves checker pass rates by 21.7–29.8 percentage points over baseline and beats either alone, but its gains are subadditive. Across the full joint grid, adding CAV to attention loses more successes than it gains in 24 of 36 comparisons. These are exploratory policy comparisons with imperfect checks and independently generated histories; they do not identify the natural cause of compliance decay.</div></details>}
}

