  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> Can language-model personas be decomposed into a small set of causally active personality traits?</summary><div class="rq-answer"><b>A.</b> Sparse mixtures drawn from 60 traits capture roughly half of a persona activation direction. Adding or removing these mixtures changes persona recognition, and related trait interventions affect sycophancy and refusal. The mixtures therefore capture a causally active part of persona behavior, rather than a complete description of each persona.</div></details>}
}

@article{kim2027whichtask,
  title       = {<a href="https://openreview.net/forum?id=PmN7pxrYc3">Which Task Loses? Understanding Asymmetrical Degradation in Model Merging</a>},
  author      = {Kim, Hak Hyun and Chin, Peter},
  research_area = {systems},
  research_topic = {model-merging},
  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> Which task suffers most when fine-tuned models are merged, and can that damage be reduced?</summary><div class="rq-answer"><b>A.</b> Two-sided capacity bounds connect interference energy and curvature to task loss. Across the tested merges, the smaller task-vector norm usually predicts greater damage, and matching training exposure removes much of this ordering signal. Shrinking the larger vector protects the smaller task in targeted tests; equalizing norms at fixed total norm can instead make damage worse.</div></details>}
}

@article{huh2027morphsae,
  title       = {<a href="https://openreview.net/forum?id=q0QR1ze7vR">MorphSAE: Reserved Sparse Slots without Automatic Component Recovery</a>},
  author      = {Huh, Benjamin and Kim, Hak Hyun and Vosoughi, Soroush},
  research_area = {interpretability-training},
  research_topic = {sparse-autoencoders},
  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> Does reserving sparse features for separate dictionaries automatically recover meaningful components?</summary><div class="rq-answer"><b>A.</b> No. MorphSAE assigns each dictionary its own TopK budget, but reserved slots alone do not reliably improve reconstruction or unsupervised specialization on natural activations. An explicit separator signal enables useful decomposition in a controlled synthetic task; a matched shared-budget model performs similarly, so the quota itself does not explain that success.</div></details>}
}

@article{kim2027repairs,
  title       = {<a href="https://openreview.net/forum?id=IDUumDpisu">One Failure, Many Repairs: Module-Level Repair Spaces in Vision–Language Models</a>},
  author      = {Kim, Hak Hyun and Chin, Peter and Vosoughi, Soroush},
  research_area = {interpretability-training},
  research_topic = {vision-language},
  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> Does a wrong answer identify one defective module in a vision-language model?</summary><div class="rq-answer"><b>A.</b> No. Fine-tuning every subset of a vision encoder, projector, and language model shows that many geometric-reasoning errors admit multiple single-module repairs. Joint training mostly reorganizes existing repairs. Detailed causal analysis also separates where parameters adapt from where a repair is computed: different adaptation routes can converge on the same late decision state.</div></details>}
}

@article{huh2027nfsae,
  title       = {<a href="https://openreview.net/forum?id=sbvkcVAWS9">NF-SAE: Testing an NMF-Inspired Sparse Autoencoder Across Language Models</a>},
  author      = {Huh, Benjamin and Peng, Jason and Kim, Hak Hyun and Vosoughi, Soroush},
  research_area = {interpretability-training},
  research_topic = {sparse-autoencoders},
  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> Do nonnegative feature strengths consistently improve sparse autoencoders across language models?</summary><div class="rq-answer"><b>A.</b> No consistent advantage appears across the tested models. NF-SAE looks promising on Gemma, but that result does not carry over to Pythia or Qwen, and BatchTopK has lower mean reconstruction and output errors wherever tested. The study highlights the need for matched controls across models before treating one-model success as a general improvement.</div></details>}
}

@article{moody2027safestgraph,
  title       = {<a href="https://openreview.net/forum?id=Pc8P3kCecq">Which Graph Is Safest? Predicting Adversarial Capture of LLM Agent Groups from Local Kernels</a>},
  author      = {Moody, Merijn and Kim, Hak Hyun and Elshatlawy, Hatem and Karwacki, Lukasz},
  research_area = {multi-agent},
  research_topic = {adversarial-robustness},
  journal     = {Under review at ICLR 2027},
  note        = {<details class="rq"><summary><b>Q.</b> Can local interaction measurements predict which communication graphs resist adversarial capture?</summary><div class="rq-answer"><b>A.</b> A question-specific switching model predicts how often an adversary converts a group majority across unseen graph configurations. Graph rankings transfer better than absolute capture probabilities. Concentrating links on one agent is consistently poor in the tested setting, while the best graph depends on the initial answer distribution and how strongly agents follow the majority.</div></details>}
}
